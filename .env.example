# ==============================================================================
# AI Agent Gateway - Environment Configuration (.env.example)
# ==============================================================================

# Application Settings
PROJECT_NAME="AI Agent Gateway"
ENVIRONMENT="development"
DEBUG=true

# Google Gemini / AI Studio API Credentials
# Official SDK: google-genai
GEMINI_API_KEY="your-google-ai-studio-api-key-here"
DEFAULT_MODEL="gemini-3.7-flash"

# Knowledge Base Configuration
ECOMMERCE_CONTEXT_PATH="data/ecommerce_business_context.md"

# Redis Configuration (Agent Context & Session Memory)
REDIS_URL="redis://localhost:6379/0"

# Django Monolith Integration
DJANGO_BACKEND_URL="http://localhost:8000"
INTERNAL_API_SECRET="change-this-to-a-secure-internal-shared-secret"

# CORS Allowed Origins (JSON array or comma-separated strings)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]
