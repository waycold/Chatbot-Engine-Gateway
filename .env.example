# =============================================================================
# Chatbot Engine Gateway — Plantilla de variables de entorno
# Copiar a `.env` y completar con credenciales reales: `cp .env.example .env`
# =============================================================================

# --- Metadatos del proyecto ---
PROJECT_NAME=AI Agent Gateway
VERSION=0.1.0
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=false

# --- Motor LLM (Google AI Studio / Gemini) ---
# Clave de Google AI Studio. Sin ella el gateway responde en modo simulado.
GEMINI_API_KEY=your-google-ai-studio-api-key-here
DEFAULT_MODEL=gemini-3.7-flash
LLM_TIMEOUT_SECONDS=10.0
LLM_MAX_RETRIES=2
LLM_INITIAL_RETRY_DELAY=0.5
LLM_BACKOFF_FACTOR=2.0
LLM_MAX_RETRY_DELAY=2.0

# --- Embeddings (pipeline RAG / pgvector) ---
# Modelo principal de embeddings (acepta hasta 8192 tokens de entrada).
EMBEDDING_MODEL=gemini-embedding-2
# Modelo secundario usado solo si el principal falla (límite de 2048 tokens).
EMBEDDING_FALLBACK_MODEL=gemini-embedding-001
# Dimensionalidad de los vectores almacenados. Debe coincidir EXACTAMENTE con la
# columna pgvector en Django: un valor distinto corrompe el ranking de búsqueda.
EMBEDDING_DIMENSIONS=768
# Truncado defensivo del TEXTO QUE SE EMBEBE (producto en ingesta, consulta en
# búsqueda) antes de llamar al modelo principal. No aplica al prompt del chat.
EMBEDDING_INPUT_MAX_CHARS=6000
# Truncado más duro para el modelo de respaldo, que sólo acepta 2048 tokens.
# Recalibrar con `scripts/calibrate_token_ratio.py`, nunca a ojo.
EMBEDDING_FALLBACK_MAX_CHARS=4500
# Cantidad máxima de tareas pendientes procesadas por corrida de ingesta.
EMBEDDING_BATCH_LIMIT=20

# --- Presupuesto de contexto del prompt de chat ---
# Límite del bloque de grounding (catálogo, contexto de negocio, salida de
# herramientas) inyectado en el prompt. Presupuesto distinto y separado del de
# embeddings: los modelos de chat aceptan entradas mucho más grandes. Si se
# recorta, se agrega un marcador visible al final del bloque.
PROMPT_CONTEXT_MAX_CHARS=24000

# --- Function Calling / bucle de herramientas ---
# Activa el bucle multi-turno de function calling de Gemini. En false los agentes
# usan únicamente el grounding eager (comportamiento previo).
ENABLE_TOOL_CALLING=true
# Máximo de rondas de llamadas a herramientas antes de forzar la respuesta final.
MAX_TOOL_ITERATIONS=4

# --- Autorización ---
# No hay lista de roles configurable: `auth_user` de Django no tiene columna de
# rol. El privilegio son los booleanos nativos `is_staff` / `is_superuser` que
# devuelve la validación de token. Cualquier request sin uno de esos dos en true
# se degrada al agente de e-commerce.

# --- Caché de validación de tokens ---
# Caché en proceso para no revalidar el mismo token contra Django varias veces en
# un mismo turno (el dispatcher y el agente de analytics validan por separado).
# En 0 se desactiva por completo.
TOKEN_VALIDATION_CACHE_TTL_SECONDS=20.0
# Máximo de tokens validados retenidos en esa caché.
TOKEN_VALIDATION_CACHE_MAX_ENTRIES=512

# --- Resiliencia de proveedor (OpenRouter — OPCIONAL) ---
# Fallback de último recurso SOLO para chat y function calling. Dejarlo vacío lo
# deshabilita por completo. NUNCA se usa para embeddings: mezclar proveedores en un
# mismo índice pgvector invalida silenciosamente el ranking.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_SECONDS=20.0

# --- Base de conocimiento y contexto de negocio ---
ECOMMERCE_CONTEXT_PATH=data/ecommerce_business_context.md

# --- Memoria de sesión distribuida (Redis) ---
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=86400

# --- Integración con el monolito Django ---
DJANGO_BACKEND_URL=http://localhost:8000
DJANGO_API_TIMEOUT_SECONDS=10.0
# Secreto compartido servicio-a-servicio. Protege los endpoints internos de
# ingesta de embeddings; debe coincidir con el valor configurado en Django.
INTERNAL_API_SECRET=your_secure_internal_token

# --- CORS ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
